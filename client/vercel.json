{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://cleancity-ai-server.vercel.app/api/$1"
    },
    {
      "source": "/health",
      "destination": "https://cleancity-ai-server.vercel.app/health"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "https://cleancity-ai-server.vercel.app/uploads/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}